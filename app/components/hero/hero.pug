// app/components/hero/hero.pug
mixin hero(data)
  // модификатор / префикс
  +modif('hero', data && data.mod)
  +prefix('hero', data && data.prefix)

  - var d      = data || {};
  - var attr   = d.attr || {};
  - var align  = d.align || 'left'; // left | right | center
  - var bg     = d.bg || '';
  - var alt    = d.alt || '';
  - var cls    = 'hero' + (typeof pr !== 'undefined' ? pr : '') + (typeof mod !== 'undefined' ? mod : '') + ' hero--align-' + align;

  section(class=cls)&attributes(attr)
    .container.hero__container
      // media: фоновое изображение или видео
      .hero__media
        if d.video
          video.hero__video(autoplay muted loop playsinline)
            source(src=d.video, type="video/mp4")
        else if bg
          if d.bgMobile
            picture.hero__media-picture
              source(media="(max-width: 991px)" srcset="./assets/images/" + d.bgMobile)
              img.hero__bg.lazyload(data-src="./assets/images/" + bg alt=alt)
          else
            +img(bg, 'hero__bg lazyload', '', alt)
        else if d.mediaBlock
          //- кастомный блок вместо картинки/видео
          != d.mediaBlock

      // контент
      - var animateMode = d.animate || 'fade';
      .hero__content(data-animate=animateMode)
        if d.pretitle
          .hero__pretitle= d.pretitle
        if d.title
          h1.hero__title!= d.title
        if d.subtitle
          p.hero__subtitle!= d.subtitle
        if d.button
          - var btnMod = (d.button.modifier) ? ' button--' + d.button.modifier : '';
          - var arrowIcon = (d.button.modifier === 'outline') ? 'icon-arrow-right-blue' : 'icon-arrow-right';
          a.hero__btn.button(class=btnMod href=d.button.url)
            span.button__text= d.button.text
            span.button__icon
              i.icon(class=arrowIcon)
