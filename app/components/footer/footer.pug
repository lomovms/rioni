mixin footer(data)
	+modif('footer', data.mod)
	+prefix('footer', data.prefix)
	- attr = data.attr || ''

	footer(class=`footer${pr}${mod}`)&attributes(attr)
		.footer__container.container
			.footer__top
				.footer__left
					a.footer__logo(href="/")
						img.footer__logo-img(src="./assets/images/required/logo-white.svg" alt="RIONI capital")
					.footer__contacts
						a.footer__contact(href="mailto:адрес.почты@gmail.ru") адрес.почты@gmail.ru
						a.footer__contact(href="tel:+995595436655") +995 595 43 66 55
						span.footer__contact.footer__contact--plain (Офис) Пн-Пт 9:00-20:00
				.footer__right
					.footer__nav
						h3.footer__nav-title Меню
						.footer__search
							input.footer__search-input(type="text" placeholder="Поиск по сайту" aria-label="Поиск по сайту")
							button.footer__search-btn(type="button" aria-label="Найти")
								span.footer__search-icon
						.footer__nav-columns
							.footer__nav-col
								a.footer__nav-link(href="about.html") О нас
								a.footer__nav-link(href="services.html") Услуги
								a.footer__nav-link(href="tariffs.html") Тарифы
								a.footer__nav-link(href="market.html") Рынок
							.footer__nav-col
								a.footer__nav-link(href="news.html") Новости
								a.footer__nav-link(href="documents.html") Документы
								a.footer__nav-link(href="#") FAQ
								a.footer__nav-link(href="training-calendar.html") Календарь
							.footer__nav-col
								a.footer__nav-link(href="training.html") Обучение
								a.footer__nav-link(href="#") Лицензии
								a.footer__nav-link(href="dictionary.html") Словарь
								a.footer__nav-link(href="news.html#memes") Юмор
							.footer__nav-col
								a.footer__nav-link(href="team.html") Команда
								a.footer__nav-link(href="career.html") Вакансии
								a.footer__nav-link(href="#") DXFina

			.footer__divider

