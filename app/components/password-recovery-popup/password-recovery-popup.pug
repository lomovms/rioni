mixin passwordRecoveryPopup()
	#password-recovery-popup.password-recovery-popup.mfp-hide.mfp-with-anim(aria-hidden="true")
		.password-recovery-popup__inner
			.password-recovery-popup__brand
				.password-recovery-popup__logo-top
					img.password-recovery-popup__logo-top-img(src="./assets/images/required/logo-rioni.svg" alt="RIONI capital" width="120" height="40")
				.password-recovery-popup__logo-main(aria-hidden="true")
					img.password-recovery-popup__logo-main-img(src="./assets/images/required/logo-form.svg" alt="")
				p.password-recovery-popup__tagline Rioni Capital - европейский брокер с грузинским колоритом

			.password-recovery-popup__form-side
				a.password-recovery-popup__back(href="#login-form" data-popup)
					span.password-recovery-popup__back-arrow
					| Назад
				h2.password-recovery-popup__title Восстановить доступ
				p.password-recovery-popup__subtitle Выберите способ восстановления пароля

				.password-recovery-popup__tabs(role="tablist" aria-label="Способ восстановления")
					button.password-recovery-popup__tab.is-active(type="button" role="tab" aria-selected="true" data-recovery-tab="phone") Телефон
					button.password-recovery-popup__tab(type="button" role="tab" aria-selected="false" data-recovery-tab="email") E-mail

				form.password-recovery-popup__form(action="#" method="post" data-recovery-form)
					.password-recovery-popup__panel.is-active(data-recovery-panel="phone")
						.registration-form__phone
							.registration-form__country.js-recovery-country-select
								.registration-form__country-trigger(role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false" aria-label="Страна")
									span.registration-form__country-flag
									span.registration-form__country-arrow
								.registration-form__country-dropdown(role="listbox" aria-hidden="true")
									.registration-form__country-option(role="option" data-value="ru" data-code="+7" tabindex="0")
										span.registration-form__country-code +7
									.registration-form__country-option(role="option" data-value="ge" data-code="+995" tabindex="0")
										span.registration-form__country-code +995
									.registration-form__country-option(role="option" data-value="am" data-code="+374" tabindex="0")
										span.registration-form__country-code +374
									.registration-form__country-option(role="option" data-value="es" data-code="+34" tabindex="0")
										span.registration-form__country-code +34
									.registration-form__country-option(role="option" data-value="pt" data-code="+351" tabindex="0")
										span.registration-form__country-code +351
									.registration-form__country-option(role="option" data-value="fr" data-code="+33" tabindex="0")
										span.registration-form__country-code +33
									.registration-form__country-option(role="option" data-value="gr" data-code="+30" tabindex="0")
										span.registration-form__country-code +30
									.registration-form__country-option(role="option" data-value="kg" data-code="+996" tabindex="0")
										span.registration-form__country-code +996
								select.registration-form__country-select(id="recovery-country" name="country" aria-label="Страна" data-recovery-country-select)
									option(value="ru" selected) RU
									option(value="ge") GE
									option(value="am") AM
									option(value="es") ES
									option(value="pt") PT
									option(value="fr") FR
									option(value="gr") GR
									option(value="kg") KG
							input.registration-form__input.registration-form__input--phone(id="recovery-phone" type="tel" name="phone" placeholder="" autocomplete="tel")
						p.password-recovery-popup__hint Введите номер телефона, который был указан при регистрации

					.password-recovery-popup__panel(data-recovery-panel="email")
						input.password-recovery-popup__input(type="email" name="email" placeholder="Введите E-mail")
						p.password-recovery-popup__hint Введите E-mail, который был указан при регистрации

					button.password-recovery-popup__submit(type="submit") Продолжить

				p.password-recovery-popup__support
					| Возникли трудности?
					a.password-recovery-popup__support-link(href="#") Обратитесь в службу поддержки
