mixin registrationBannedPopup()
	#registration-banned-popup.site-popup.site-popup--status.mfp-hide.mfp-with-anim(aria-hidden="true" role="dialog" aria-labelledby="registration-banned-title" aria-modal="true")
		.site-popup__inner.site-popup__inner--status
			.site-popup__status-top
				img.site-popup__status-logo(src="./assets/images/required/logo-rioni.svg" alt="Rioni Capital" width="120" height="40")
			.site-popup__status-center.site-popup__status-center--compact
				.site-popup__status-visual(aria-hidden="true")
					img.site-popup__status-icon(src="./assets/images/required/ban.png" alt="" width="114" height="114")
				h2#registration-banned-title.site-popup__status-title Вход недоступен для данного пользователя
				p.site-popup__status-text К сожалению, на данный момент мы не готовы предоставить вам доступ к материалам Rioni Capital исходя из внутренней политики компании. Если решение будет пересмотрено, вы получите уведомление на электронную почту

mixin registrationCompletedPopup()
	#registration-completed-popup.site-popup.site-popup--status.site-popup--status-soft.mfp-hide.mfp-with-anim(aria-hidden="true" role="dialog" aria-labelledby="registration-completed-title" aria-modal="true")
		.site-popup__inner.site-popup__inner--status
			.site-popup__status-top
				img.site-popup__status-logo(src="./assets/images/required/logo-rioni.svg" alt="Rioni Capital" width="120" height="40")
			a.site-popup__status-back(href="#registration-form" data-popup)
				span.site-popup__status-back-arrow(aria-hidden="true")
				| Назад
			.site-popup__status-center
				.site-popup__status-visual.site-popup__status-visual--soft(aria-hidden="true")
					img.site-popup__status-icon(src="./assets/images/required/mail.png" alt="" width="114" height="114")
				h2#registration-completed-title.site-popup__status-title Регистрация завершена!
				p.site-popup__status-text Брокерский счет формируется, вы получите уведомление об открытии на почту
					span.site-popup__status-email#registration-completed-email takoytotam@mail.ru
			p.site-popup__status-support
				| Возникли трудности?
				a.site-popup__status-support-link(href="#") Обратитесь в службу поддержки
