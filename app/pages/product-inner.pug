extends template/layout
include ../components/content-page/content-page

block variables
	- var title = 'Внутренняя страница продукта — Rioni Capital';
	- var menuHeader = [{ title: 'О нас', href: 'about.html' }, { title: 'Услуги', href: 'services.html' }, { title: 'Тарифы', href: 'tariffs.html' }, { title: 'Обучение', href: 'training.html' }, { title: 'Рынок', href: 'market.html' }, { title: 'Документы', href: 'documents.html' }];
	- var showTopbar = false;
	- var headerCta = { text: 'Открыть счет', href: '#registration-form' };
	- var pageData = {
	-   title: 'Почему выбирают Rioni Capital',
	-   intro: 'Собранные в одной экосистеме глобальные рынки, аналитика и современные торговые технологии — это то, что мы в Rioni Capital адаптировали для клиентов с развивающихся рынков и добавили нашу фирменную грузинскую поддержку клиентов.',
	-   heroImage: 'required/product-inner-hero.png',
	-   heroImageMobile: 'required/product-inner-hero-m.png',
	-   heroLink: { text: 'К странице с документами', mobileText: 'к Документам', href: 'documents.html' },
	-   trust: {
	-     title: 'Почему нам доверяют?',
	-     items: [
	-       { title: 'Прозрачность и открытость', text: 'Мы придерживаемся принципов максимальной прозрачности и раскрываем информацию в объёме, предусмотренном законодательством Грузии, требованиями Национального банка Грузии и внутренними стандартами компании. Клиентам доступны корпоративные документы, информация о финансовой отчётности, существенных событиях, условиях обслуживания и другие сведения, необходимые для принятия взвешенных инвестиционных решений.' },
	-       { title: 'Независимый контроль', text: 'Компания Rioni Capital регулярно проходит независимые аудиторские проверки, а также процедуры due diligence, проводимые международными финансовыми партнёрами при установлении и сохранении деловых отношений.' },
	-       { title: 'Современное регулирование финансового рынка', text: 'Регулирование финансового рынка Грузии развивается с учётом европейских стандартов и лучших международных практик. Деятельность Rioni Capital осуществляется на основании лицензии Национального банка Грузии.' },
	-       { title: 'Деятельность в соответствии с законодательством Грузии и лучшими европейскими практиками', text: 'Rioni Capital осуществляет деятельность в соответствии с законодательством Грузии и требованиями Национального банка Грузии. При разработке внутренних документов и корпоративных стандартов компания использует лучшие европейские практики регулирования инвестиционных услуг.' }
	-     ]
	-   },
	-   toc: [
	-     { title: 'Истории денег', href: 'third-level.html' },
	-     { title: 'Истории знаменитых инвесторов', href: 'famous-investors.html' },
	-     { title: 'Рынок акций и ETF', href: 'product-inner.html' },
	-     { title: 'Глобальные рынки', href: 'market.html' },
	-     { title: 'Торговая платформа', href: 'platform.html' },
	-     { title: 'Доверие и уважение', href: 'trust.html' },
	-     { title: 'Раскрытие информации', href: 'disclosure.html' },
	-     { title: 'Документы', href: 'documents.html' },
	-     { title: 'Обучение инвестированию', href: 'training.html' },
	-     { title: 'Глоссарий инвестора', href: 'dictionary.html' }
	-   ],
	-   tocCurrent: 2,
	-   sections: [],
	-   banner: null
	- };

block content
	+contentPage(pageData)
