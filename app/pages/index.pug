extends template/layout
include ../components/trust-slider/trust-slider
//- include ../components/menu/menu

block variables
	- var title = 'Главная — Rioni';
	- var menuHeader = [
	-   { title: 'О нас', href: 'about.html' },
	-   { title: 'Услуги', href: 'services.html' },
	-   { title: 'Инструменты', href: 'products.html' },
	-   { title: 'Тарифы', href: '#' },
	-   { title: 'Обучение', href: '#' },
	-   { title: 'Рынок', href: 'market.html' },
	-   { title: 'Документы', href: 'documents.html' }
	- ];
	- var showTopbar = false
	- var headerCta = { text: 'Открыть счет', href: '#registration-form' };

block content
	//- h1 Тест
	//- +menu(menuHeader)
	//- +img('example/preview.jpg', `lazyload`)

	//- svg
	//- 	use(xlink:href="/assets/images/required/sprite.svg#accordion")
	+hero({
			topbar: true,
			topbarLinks: [
				{ text: 'Для физических лиц', href: '#' },
				{ text: 'Для юридических лиц', href: '#' }
			],
			bg: 'required/hero-main.png',
			bgMobile: 'required/hero-main-mobile.jpg',
			mod: 'main',
			align: 'right',
			pretitle: '',
			title: 'Rioni Capital –<br>европейский брокер<br>с грузинским колоритом',
			subtitle: 'Мы объединяем европейские стандарты, инновационные технологии и тёплый грузинский сервис, чтобы вы могли <br class="hidden-xs--small hidden-xs">инвестировать уверенно и прозрачно',
			button: { text: 'Открыть счет', url: '#' },
			animate: 'fade'
		})
	section.section-features
		.container
			.features__center
				h1.features__title.features__title--desktop.hidden-xs--small.hidden-xs
					span.line Откройте для себя
					span.line все грани
					span.line инвестирования
					span.line вместе с Rioni Capital
				h1.features__title.features__title--mobile
					span.line Откройте
					span.line для себя
					span.line все грани
					span.line инвестирования
					span.line вместе
					span.line с Rioni Capital
			.features
				a.float-card.float-card--1(data-strength="0.10")
					img(src="./assets/images/required/card1.png" alt="")
				a.float-card.float-card--2(data-strength="0.12")
					img(src="./assets/images/required/card2.png" alt="")
				a.float-card.float-card--3(data-strength="0.08")
					img(src="./assets/images/required/card3.png" alt="")
				a.float-card.float-card--4(data-strength="0.06")
					img(src="./assets/images/required/card4.png" alt="")
				a.float-card.float-card--5(data-strength="0.03")
					img(src="./assets/images/required/card5.png" alt="")
				a.float-card.float-card--6(data-strength="0.01")
					img(src="./assets/images/required/card6.png" alt="")
			.features__bottom
				h2.features__bottom-title Инвестировать просто!
				p.features__bottom-text Rioni Capital обещает своим клиентам надежный и безопасный
					br
					| доступ к международным финансовым рынкам через инновационные и удобные цифровые платформы

	section.section-services(id="services")
		.container
			.services
				.services__left
					// Прогресс-бары для каждого слайда
					ul.services__progress
						li.service__bar
							.service__bar-fill
						li.service__bar
							.service__bar-fill
						li.service__bar
							.service__bar-fill
						li.service__bar
							.service__bar-fill
					// Контент текущего слайда (меняется динамически)
					.service__content
						h3.service__title Брокерские услуги
						p.service__desc Индивидуальные стратегии, доступ к рынкам...

				.services__right
					// Рамка ПК
					.device.device--desktop
						img.device__frame(src="./assets/images/required/monitor-frame.png" alt="")
						.device__screen
							img.device__gif-desktop(src="./assets/images/required/gif.png" alt="")
					// Рамка телефона
					.device.device--mobile
						img.device__frame(src="./assets/images/required/phone-frame.png" alt="")
						.device__screen
							img.device__gif-mobile(src="./assets/images/required/gif.png" alt="")

				// Сам слайдер (без контента — хранит метаданные)
				.services__swiper.swiper
					.swiper-wrapper
						.swiper-slide(
							data-title="Брокерские услуги и инвестиционное консультирование"
							data-desc="Профессиональный инвестиционный консалтинг помогает клиентам разрабатывать индивидуальные стратегии для достижения любых финансовых целей - рост, получение дохода или управление рисками. || Расширенный доступ к различным финансовым рынкам, и торговля ценными бумагами - акции, облигации и ETF"
							data-gif-desktop="./assets/images/required/gif.png"
							data-gif-mobile="./assets/images/required/gif.png")
						.swiper-slide(
							data-title="Консалтинг и аналитика"
							data-desc="Экспертные советы, глубокий анализ рынка, персональные рекомендации"
							data-gif-desktop="./assets/images/required/gif2.png"
							data-gif-mobile="./assets/images/required/gif2.png")
						.swiper-slide(
							data-title="Автоследование и портфели"
							data-desc="Готовые портфельные решения, автоматическое копирование сделок"
							data-gif-desktop="./assets/images/required/gif.png"
							data-gif-mobile="./assets/images/required/gif.png")
						.swiper-slide(
							data-title="Управление капиталом"
							data-desc="Персональное управление активами, диверсификация портфеля, контроль рисков"
							data-gif-desktop="./assets/images/required/gif.png"
							data-gif-mobile="./assets/images/required/gif.png")
	section.section-planet(id="planet")
		.container.planet__container-wrap
			.planet__desktop
				.planet__controls
					button.planet__play(type="button") Запустить анимацию
					.planet__progress-wrap
						label.planet__progress-label(for="planet-progress") Прогресс
						input.planet__progress-input#planet-progress(type="range" min="0" max="1000" step="1" value="0" aria-label="Прогресс анимации")
						output.planet__progress-value(for="planet-progress") 0.0%
				.planet__light
					img(src="./assets/images/required/light.png" alt="")
				.planet__light2
					img(src="./assets/images/required/light2.png" alt="")
				.planet__container
					.planet__globe
						img.planet__earth(src="./assets/images/required/earth.png" alt="")
						img.planet__clients(src="./assets/images/required/clients.png" alt="")
				.planet__title-wrap
					h2.planet__title Rioni Capital -<br>инвестируй<br>по всему миру
				.planet__content
					.planet__stats
						.planet__stat
							span.planet__stat-num 160
							span.planet__stat-label Рынков
						.planet__stat
							span.planet__stat-num 36
							span.planet__stat-label Стран
						.planet__stat
							span.planet__stat-num 28
							span.planet__stat-label Валют
					p.planet__text Инвестируйте по всему миру в акции, опционы, фьючерсы, валюты, облигации и фонды с единой унифицированной платформы.

			.planet__mobile
				.planet__mobile-screen.planet__mobile-screen--hero
					h2.planet__mobile-title Rioni Capital -<br>инвестируй<br>по всему миру
					.planet__mobile-globe.planet__mobile-globe--hero
						img.planet__mobile-earth(src="./assets/images/required/earth.png" alt="")
				.planet__mobile-screen.planet__mobile-screen--details
					.planet__mobile-copy
						h2.planet__mobile-title.planet__mobile-title--left Rioni Capital -<br>инвестируй<br>по всему миру
						.planet__mobile-stats
							.planet__mobile-stat
								span.planet__mobile-stat-num 160
								span.planet__mobile-stat-label Рынков
							.planet__mobile-stat
								span.planet__mobile-stat-num 36
								span.planet__mobile-stat-label Стран
							.planet__mobile-stat
								span.planet__mobile-stat-num 28
								span.planet__mobile-stat-label Валют
						p.planet__mobile-text Инвестируйте по всему миру в акции, опционы, фьючерсы, валюты, облигации и фонды с единой унифицированной платформы.
					.planet__mobile-globe.planet__mobile-globe--details
						img.planet__mobile-light(src="./assets/images/required/light2.png" alt="")
						img.planet__mobile-earth(src="./assets/images/required/earth.png" alt="")
						img.planet__mobile-clients(src="./assets/images/required/clients.png" alt="")
	- var partnersList = [{img:"./assets/images/required/prime.png",text:"A globally-renowned charting platform integrated with the DXtrade backend for trade execution"},{img:"./assets/images/required/kenmore.png",text:"A globally-renowned charting platform integrated with the DXtrade backend for trade execution"},{img:"./assets/images/required/propguru.png", text:"A globally-renowned charting platform integrated with the DXtrade backend for trade execution"},{img:"./assets/images/required/propguru.png", text:"A globally-renowned charting platform integrated with the DXtrade backend for trade execution"},{img:"./assets/images/required/prime.png",text:"A globally-renowned charting platform integrated with the DXtrade backend for trade execution"}]
	section.section-partners
		.container
			.partners
				.partners__intro
					h2.partners__title Партнеры
					p.partners__text Мы сотрудничаем с ведущими компаниями и организациями в области финансов и инвестиций.
						br
						| Наши партнеры - это профессионалы, которые помогают нам обеспечить высокий уровень сервиса и надежности
				.partners__marquee
					.partners__track
						each partner in partnersList
							.partner-card
								.partner-card__image
									img(src=partner.img alt=partner.text)
								.partner-card__text= partner.text
						each partner in partnersList
							.partner-card(aria-hidden="true")
								.partner-card__image
									img(src=partner.img alt="")
								.partner-card__text= partner.text
					.partners__track.partners__track--reverse
						each partner in partnersList
							.partner-card
								.partner-card__image
									img(src=partner.img alt=partner.text)
								.partner-card__text= partner.text
						each partner in partnersList
							.partner-card(aria-hidden="true")
								.partner-card__image
									img(src=partner.img alt="")
								.partner-card__text= partner.text

	//- Слайдер «колода карт» перед формой
	+trustSlider(trustSlider)

	//- Секция формы обратной связи перед футером
	+sectionForm()
