block content
	section.section-news-page
		.container
			.news-page
				.news-page__body
					.news-page__main
						h1.news-page__title Новости Rioni Capital
						form.news-page__search(role="search")
							label.news-page__search-label(for="news-search")
							input.news-page__search-input#news-search(type="search" name="q" placeholder="Поиск" aria-label="Поиск по новостям")

						.news-page__cards(data-news-page-cards)
							each item, index in newsCards
								article.news-page-card(class=index >= 4 ? 'news-page-card--extra' : '')
									a.news-page-card__link(href="article.html")
										.news-page-card__image
											img(src=`./assets/images/required/${item.image}` alt=item.title)
										.news-page-card__body
											h2.news-page-card__title= item.title
											p.news-page-card__text= item.text
											time.news-page-card__date(datetime="2022-12-22")= item.date

						button.news-page__more(type="button" data-news-page-more="cards")
							span.news-page__more-arrow(aria-hidden="true")
							span Показать больше

						.news-page__memes
							h2.news-page__memes-title Немного юмора:
								br
								| Расслабьтесь и Улыбнитесь
							p.news-page__memes-text Инвестиции и финансовые рынки могут утомить, поэтому всегда полезно посмеяться и сделать свою жизнь более приятной. Разбавьте жизнь веселыми мемами!
							.news-page__masonry(data-news-page-masonry)
								each meme, index in memes
									article(class=`news-meme-card news-meme-card--${meme.mod} ${index >= 8 ? 'news-meme-card--extra' : ''}`)
										img.news-meme-card__img(src=`./assets/images/required/mem/${meme.image}` alt="Мем")

						button.news-page__more(type="button" data-news-page-more="memes")
							span.news-page__more-arrow(aria-hidden="true")
							span Показать больше

					aside.news-page__sidebar
						.market-widget.market-widget--banner
							.market-widget__inner
								p.market-widget__title Рекламный баннер
								p.market-widget__text Тут написать любую нашу рекламу продукта или важную информацию, которую мы хотим донести до клиента
								a.market-widget__btn.button(href="#")
									span.button__text подробнее
									span.button__icon
										i.icon.icon-arrow-right

						.market-widget.market-widget--quotes(data-market-widget="quotes")
							.market-widget__header
								.market-widget__heading-row
									h3.market-widget__heading Список котировок
									button.market-widget__dropdown(type="button" aria-label="Развернуть список" data-quotes-dropdown)
										span.market-widget__dropdown-arrow
								.market-widget__actions
									button.market-widget__action(type="button" aria-label="Добавить") +
									button.market-widget__action(type="button" aria-label="Убрать") −
									button.market-widget__action(type="button" aria-label="Ещё") …
							.market-widget__body
								.market-quotes
									table.market-quotes__table
										thead.market-quotes__head
											tr
												th.market-quotes__th Инструм
												th.market-quotes__th Посл. ц.
												th.market-quotes__th Изм.
												th.market-quotes__th Изм. %
										tbody.market-quotes__body
											tr.market-quotes__row
												td.market-quotes__cell IRUS
												td.market-quotes__cell 3 121,57
												td.market-quotes__cell.market-quotes__cell--neg -62,40
												td.market-quotes__cell.market-quotes__cell--neg -1,96%
											tr.market-quotes__row
												td.market-quotes__cell RTSI
												td.market-quotes__cell 1 135,27
												td.market-quotes__cell.market-quotes__cell--neg -22,68
												td.market-quotes__cell.market-quotes__cell--neg -1,96%
											tr.market-quotes__row
												td.market-quotes__cell SPX
												td.market-quotes__cell 5 521,52
												td.market-quotes__cell.market-quotes__cell--neg -77,78
												td.market-quotes__cell.market-quotes__cell--neg -1,39%
											tr.market-quotes__row
												td.market-quotes__cell NDQ
												td.market-quotes__cell 19 225,4
												td.market-quotes__cell.market-quotes__cell--neg -370,54
												td.market-quotes__cell.market-quotes__cell--neg -1,89%
									.market-quotes__subsection
										.market-quotes__subtitle Акции
										table.market-quotes__table
											tbody.market-quotes__body
												tr.market-quotes__row
