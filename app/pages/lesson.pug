									img(src="./assets/images/required/curse4.png" alt="Урок 4")
									.learning-course-card__lock-badge
										img(src="./assets/images/required/lock3.png" alt="" aria-hidden="true")
								.learning-course-card__body
									h3.learning-course-card__title 4 урок из курса
									p.learning-course-card__text Тут написать подзаголовок об истории успеха или провала на инвестиционном рынке

				aside.lesson-page__aside
					.lesson-widget
						h3.lesson-widget__title Календарь
						.lesson-widget__calendar
							p.lesson-widget__calendar-month Сентябрь 2025
